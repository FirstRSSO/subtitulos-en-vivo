{
  "manifest_version": 3,
  "name": "Whisper Turbo Subtitles",
  "version": "1.1",
  "description": "Traductor en tiempo real usando backend local/Cloudflare",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.trycloudflare.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Traductor de Audios",
    "default_popup": "popup.html"
  }
}
